; The "y" that picks the RVY spelling can appear anywhere in the mnemonic,
; not just as a prefix, e.g. the ".y" suffix on an atomic mnemonic.
define ptr addrspace(200) @test_amoswap(ptr addrspace(200) %addr, ptr addrspace(200) %val) nounwind {
; CHECK-LABEL: test_amoswap:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    amoswap.c ca0, ca1, (ca0)
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ret
;
; RAW-LABEL: test_amoswap:
; RAW:       # %bb.0: # %entry
; RAW-NEXT:    #APP
; RAW-NEXT:    amoswap.c ca0, ca1, (ca0)
; RAW-NEXT:    #NO_APP
; RAW-NEXT:    ret
entry:
  %0 = tail call ptr addrspace(200) asm "amoswap.c $0, $2, ($1)", "=C,C,C"(ptr addrspace(200) %addr, ptr addrspace(200) %val)
  ret ptr addrspace(200) %0
}


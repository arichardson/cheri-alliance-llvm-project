; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: %riscv64_cheri_purecap_llc -mattr=+a < %s | FileCheck %s
; RUN: %riscv64_cheri_purecap_llc -mattr=+a -no-integrated-as < %s | FileCheck %s --check-prefix=RAW

; Check that a "C"-constrained operand is spelled the way the mnemonic
; expects: "c"-prefixed for xcheri/ISAv9, plain GPR names for RVY (y-family).
; RAW shows the text we emit; CHECK shows it after the integrated assembler
; round-trips it, which only succeeds if the spelling was accepted.

define ptr addrspace(200) @test_load(ptr addrspace(200) %cap) nounwind {
; CHECK-LABEL: test_load:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    lc ca0, 16(ca0)
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ret
;
; RAW-LABEL: test_load:
; RAW:       # %bb.0: # %entry
; RAW-NEXT:    #APP
; RAW-NEXT:    clc ca0, 16(ca0)
; RAW-NEXT:    #NO_APP
; RAW-NEXT:    ret
entry:
  %0 = tail call ptr addrspace(200) asm "clc $0, $1($2)", "=C,i,C"(i32 16, ptr addrspace(200) %cap)
  ret ptr addrspace(200) %0
}


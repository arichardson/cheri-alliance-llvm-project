; A memory constraint picks the base register via PrintAsmMemoryOperand.
define ptr addrspace(200) @test_load_mem(ptr addrspace(200) %cap) nounwind {
; CHECK-LABEL: test_load_mem:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    lc ca0, 0(ca0)
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ret
;
; RAW-LABEL: test_load_mem:
; RAW:       # %bb.0: # %entry
; RAW-NEXT:    #APP
; RAW-NEXT:    clc ca0, 0(ca0)
; RAW-NEXT:    #NO_APP
; RAW-NEXT:    ret
entry:
  %0 = tail call ptr addrspace(200) asm "clc $0, $1", "=C,*m"(ptr addrspace(200) elementtype(i64) %cap)
  ret ptr addrspace(200) %0
}

